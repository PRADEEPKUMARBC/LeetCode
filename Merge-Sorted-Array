class Solution(object):
    def merge(self, nums1, m, nums2, n):
        """
        :type nums1: List[int]
        :type m: int
        :type nums2: List[int]
        :type n: int
        :rtype: None Do not return anything, modify nums1 in-place instead.
        """
        
        merged = []
        i = 0
        j = 0
        while i < m and j < n:
            if nums1[i] < nums2[j]:
                merged.append(nums1[i])
                i += 1
            elif nums1[i] == nums2[j]:
                merged.append(nums1[i])
                merged.append(nums2[j])
                i += 1
                j += 1
            elif nums1[i] > nums2[j]:
                merged.append(nums2[j])
                j += 1

        # add elements from nums1
        while i < m:
            merged.append(nums1[i])
            i += 1
        
        while j < n:
            merged.append(nums2[j])
            j += 1
        
        for i in range(m + n):
            nums1[i] = merged[i]
