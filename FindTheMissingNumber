nums = [9, 6, 5, 4, 7, 3, 2, 1, 0]

def missingNumber(nums):
    n= len(nums) 
    freq = {}

    for i in range(0, n + 1):
        freq[i] = 0

    for num in nums:
        freq[num] = 1

    for k,v in freq.items():
        if v == 0:
            return k

print(missingNumber(nums))

