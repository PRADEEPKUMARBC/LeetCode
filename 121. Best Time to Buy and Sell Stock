class Solution(object):
    def maxProfit(self, prices):
        
        max_profit = 0
        n = len(prices)
        for i in range(0, n):
            for j in range(i+1, n):
                if prices[j] > prices[i]:
                    p = prices[j] - prices[i]
                    max_profit = max(max_profit, p)
        return max_profit
