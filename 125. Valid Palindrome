class Solution:
    def isPalindrome(self, s: str) -> bool:
        low_case_let = s.lower()

        new_string = ""

        for char in low_case_let:
            if char.isalnum():
                new_string += char

        length = len(new_string)

        for i in range(length // 2):
            if new_string[i] != new_string[length - 1 - i]:
                return False
        return True
