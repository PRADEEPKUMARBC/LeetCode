# first solution
class Solution(object):
    def longestConsecutive(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        max_count = 0
        for i in range(0, n):
            num = nums[i]
            count = 1
            while num + 1 in nums:
                count += 1
                num += 1
            max_count = max(max_count, count)
        return max_count

# second solution
class Solution(object):
    def longestConsecutive(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        nums.sort()
        count = 0
        last_number = float("-inf")
        longest = 0
        for i in range(0, len(nums)):
            num = nums[i]
            if num - 1 == last_number:
                count += 1
                last_number = num
            elif num != last_number:
                count += 1
                last_number = num
            longest = max(longest, count)
        return longest
